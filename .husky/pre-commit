#!/bin/sh
# Husky pre-commit hook for TypeScript projects
# See: platform/.github/dev-tools/hooks/ts-husky-template/

# Verify commit signing is configured
signing_key=$(git config --get user.signingkey 2>/dev/null || echo "")
gpg_sign=$(git config --get commit.gpgsign 2>/dev/null || echo "false")

if [ -z "$signing_key" ] || [ "$gpg_sign" != "true" ]; then
  echo "ERROR: Commit signing not configured."
  echo ""
  echo "Configure with:"
  echo "  GPG:  git config --global user.signingkey <GPG_KEY_ID>"
  echo "  SSH:  git config --global user.signingkey ~/.ssh/id_ed25519.pub"
  echo "  Then: git config --global commit.gpgsign true"
  echo ""
  echo "See: https://docs.github.com/en/authentication/managing-commit-signature-verification"
  exit 1
fi

# Run lint-staged
npx lint-staged
